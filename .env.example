# Postgres (Supabase). Use a connection string com pgbouncer (porta 6543) para app,
# e a direta (porta 5432) para migrations, se o seu plano do Supabase exigir isso.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Auth.js — gerar com `npx auth secret`
AUTH_SECRET=""

# Fuso horário
TZ="America/Sao_Paulo"

# Protege a rota de keep-alive do Supabase (ver vercel.json "crons")
CRON_SECRET=""

# Chave pública (anon) da API REST do Supabase — usada só pelo ping de keep-alive
SUPABASE_ANON_KEY=""

# Supabase Storage (armazenamento de evidências/fotos, via API S3-compatível)
SUPABASE_PROJECT_REF=""
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
SUPABASE_STORAGE_BUCKET="evidence"
SUPABASE_S3_REGION="us-east-1"

# Gemini (assistente de IA). A chave é limpa de caracteres invisíveis no código.
# GEMINI_MODEL é opcional (padrão: gemini-2.5-flash, com reserva gemini-2.0-flash).
GEMINI_API_KEY=
# GEMINI_MODEL=
